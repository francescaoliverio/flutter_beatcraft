{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:developer.jamendo.com)",
      "WebFetch(domain:devportal.jamendo.com)",
      "WebFetch(domain:dummyjson.com)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:riverpod.dev)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:developer.apple.com)",
      "Bash(file assets/images/*/*)",
      "Bash(flutter pub *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh *)"
    ]
  }
}
